{
  "name": "tera-tsugu-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env scripts/test.ts",
    "db:push": "tsx --env-file-if-exists=.env scripts/db-push.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed/index.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/db-reset.ts",
    "mcp": "tsx --env-file-if-exists=.env src/mcp/server.ts",
    "mcp:config": "tsx --env-file-if-exists=.env scripts/mcp-config.ts",
    "apps:gen": "tsx scripts/apps.ts gen",
    "apps:check": "tsx scripts/apps.ts check",
    "kit:build": "tsx scripts/build-kit.ts",
    "predev": "npm run apps:gen",
    "prebuild": "npm run apps:gen"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
