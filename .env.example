# DB の接続先。worktree ごとに DB の名前を変える（例: tera_ledger）。DB がなければ npm run db:reset が作る
DATABASE_URL=postgres://tera:tera@localhost:5432/tera
# ログインの状態を署名する鍵。生成方法: openssl rand -base64 32
SESSION_SECRET=dev-only-secret-change-me-0123456789abcdef
# MCP サーバーの操作者（スタッフのメールアドレス）
MCP_ACTOR=jushoku@example.com
# 公開リンク（フォームの URL など）の基準
APP_BASE_URL=http://localhost:3000
# お寺のアプリの利用者のデータを暗号化する鍵（32 バイトを base64 で）。生成方法: openssl rand -base64 32
# 開発では未設定でもよい（開発用の鍵を使う）。本番では必ず設定し、変えると過去のデータを読めなくなる
APPS_ENCRYPTION_KEY=
